# Secrets: never commit. platform/tests/unit/test_repo_hygiene.py fails if .env is tracked.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.import_linter_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# Local working notes during the build; deleted at release.
.dev/

# The spend ledger lives outside the repository (~/.datapilot/); never commit a copy.
*.sqlite
*.sqlite-wal
*.sqlite-shm

# DataPilot runtime output: generated seed files and exports.
.runs/
exports/
guide/build/

# Playwright
playwright-report/
test-results/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Agent worktrees for the parallel tracks (each is its own branch).
.claude/worktrees/

# Generated slide builds and renders (slides/source/build_deck.py, slides/scripts/render_png.ps1).
slides/build/
section-*/assignment/solution/
