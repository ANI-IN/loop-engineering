    },
    {
      "id": "run-lifecycle-text-74",
      "type": "text",
      "x": 1135,
      "y": 88,
      "width": 617.6,
      "height": 575,
      "angle": 0,
      "strokeColor": "#212121",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0C",
      "roundness": null,
      "seed": 1376578810,
      "version": 1,
      "versionNonce": 283689339,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": " 1  received to queued, api: POST /events, with the job row\n 2  queued to running, worker: claim\n 3  queued to blocked_budget, worker: budget check before claim\n 4  queued to blocked_killswitch, worker: kill switch check at claim\n 5  running to queued, reaper: expired lease, attempts left\n 6  running to verifying, worker: agent returned an answer envelope\n 7  running to awaiting_approval, worker: human approval interrupt\n 8  running to escalated, worker: retry, call, or token limit reached\n 9  running to failed, worker or reaper: error, or attempts exhausted\n10  running to blocked_budget, worker: token budget exhausted mid-run\n11  running to blocked_killswitch, worker: kill switch before a model call\n12  verifying to running, worker: a grader failed, retry within the cap\n13  verifying to answered, worker: every grader passed\n14  verifying to awaiting_approval, worker: reviewer concern persists\n15  verifying to escalated, worker: final-answer grader failed at the cap\n16  verifying to blocked_killswitch, worker: kill switch while verifying\n17  verifying to failed, worker or reaper: error while verifying\n18  awaiting_approval to running, worker: approval resumed the run\n19  awaiting_approval to answered, api: approval of a held answer\n20  awaiting_approval to rejected, api: POST /approvals/{run_id} reject\n21  awaiting_approval to blocked_killswitch, api: kill switch engaged\n22  answered to posted, worker: posted to the channel per autonomy policy\n23  answered to awaiting_approval, worker: autonomy policy needs approval",
      "originalText": " 1  received to queued, api: POST /events, with the job row\n 2  queued to running, worker: claim\n 3  queued to blocked_budget, worker: budget check before claim\n 4  queued to blocked_killswitch, worker: kill switch check at claim\n 5  running to queued, reaper: expired lease, attempts left\n 6  running to verifying, worker: agent returned an answer envelope\n 7  running to awaiting_approval, worker: human approval interrupt\n 8  running to escalated, worker: retry, call, or token limit reached\n 9  running to failed, worker or reaper: error, or attempts exhausted\n10  running to blocked_budget, worker: token budget exhausted mid-run\n11  running to blocked_killswitch, worker: kill switch before a model call\n12  verifying to running, worker: a grader failed, retry within the cap\n13  verifying to answered, worker: every grader passed\n14  verifying to awaiting_approval, worker: reviewer concern persists\n15  verifying to escalated, worker: final-answer grader failed at the cap\n16  verifying to blocked_killswitch, worker: kill switch while verifying\n17  verifying to failed, worker or reaper: error while verifying\n18  awaiting_approval to running, worker: approval resumed the run\n19  awaiting_approval to answered, api: approval of a held answer\n20  awaiting_approval to rejected, api: POST /approvals/{run_id} reject\n21  awaiting_approval to blocked_killswitch, api: kill switch engaged\n22  answered to posted, worker: posted to the channel per autonomy policy\n23  answered to awaiting_approval, worker: autonomy policy needs approval",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
