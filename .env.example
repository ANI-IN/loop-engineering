# DataPilot configuration. Copy to .env at the repository root and fill in the two keys:
#   cp .env.example .env        (make setup does it)
# .env is git-ignored. Never commit it, paste it into an issue, or share a screenshot of it.
# Keys are never printed, logged, or written to ops tables or traces.

# --- Required -----------------------------------------------------------------
# OpenAI API key from a paid account (Build tier or higher).
OPENAI_API_KEY=
# LangSmith API key from a free Developer account.
LANGSMITH_API_KEY=

# --- Models ---------------------------------------------------------------------
# The analyst, the schema scout, and the reviewer. Ask the operations team to enable gpt-6-luna
# on your key, or allow it on your own OpenAI project; make preflight names the model if your key
# cannot use it. It has no dated snapshot, so
# make preflight runs a canary (three easy questions pass, two trap questions still fail under
# the starting knowledge) before every class. Reasoning effort per agent is in pack.yaml; every
# call uses the Responses API and never passes temperature.
OPENAI_MODEL=gpt-6-luna
# The analyzer team (failure analyst, rule writer, critic). Empty means OPENAI_MODEL.
OPENAI_ANALYZER_MODEL=gpt-6-luna

# --- LangSmith ------------------------------------------------------------------
LANGSMITH_TRACING=true
# EU accounts: https://eu.api.smith.langchain.com (no trailing slash)
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Live runs trace here; experiments go to LANGSMITH_EXPERIMENTS_PROJECT.
LANGSMITH_PROJECT=datapilot-live
LANGSMITH_EXPERIMENTS_PROJECT=datapilot-experiments

# --- Domain pack ----------------------------------------------------------------
# The pack every process reads: a folder under platform/packs/. datapilot_us is Harbor & Pine, the
# class pack; _template is the template pack. After a change, run make up, then make preflight.
DATAPILOT_PACK=datapilot_us

# --- Databases (one URL per role) -----------------------------------------------
# Left unset, each address is the Compose one on POSTGRES_PORT (below), so a moved port moves every
# host command with it. Set one only for a Postgres of your own; it then wins over the port.
# Owner role: migrations, seeding, ops tables. Never given to the agent.
# DATABASE_URL_OWNER=postgresql://datapilot_owner:datapilot_owner@localhost:5432/datapilot
# The agent's read-only role on the warehouse schema.
# DATABASE_URL_AGENT=postgresql://datapilot_agent_ro:datapilot_agent_ro@localhost:5432/datapilot
# The same role on the second, differently seeded database used by the evaluator.
# DATABASE_URL_AGENT_ALT=postgresql://datapilot_agent_ro:datapilot_agent_ro@localhost:5432/warehouse_alt
# The same two addresses as the services in Docker reach them. Inside a container, localhost is the
# container itself; unset, the services use the Compose Postgres by its service name, postgres.
# Set both when the agent reads your own Postgres (use-in-your-repo/apply-to-your-repo.md, part 3).
# SERVICES_DATABASE_URL_AGENT=postgresql://datapilot_agent_ro:datapilot_agent_ro@postgres:5432/datapilot
# SERVICES_DATABASE_URL_AGENT_ALT=postgresql://datapilot_agent_ro:datapilot_agent_ro@postgres:5432/warehouse_alt
# Optional: the superuser that `make seed` uses to set agent-role limits only a superuser may set,
# read from here or from the shell. Unset, it uses the local Compose superuser on the owner's server.
# DATABASE_URL_SUPERUSER=postgresql://postgres:postgres@localhost:5432/postgres
# The application role for ops tables (api, worker, scheduler, console).
# DATABASE_URL_APP=postgresql://datapilot_app:datapilot_app@localhost:5432/datapilot

# Host ports for Compose (change one when another program holds it, or to run a second copy side by
# side). The host commands follow them too: the database addresses above and DATAPILOT_API_URL
# below, while those are unset, and make preflight's console check. After a change, run make up.
POSTGRES_PORT=5432
API_PORT=8000
CONSOLE_PORT=8501

# --- Spend ----------------------------------------------------------------------
# Every model call is recorded with its tokens and cost (prices in pack.yaml) in the spend ledger,
# the SQLite file ~/.datapilot/spend-ledger.sqlite, outside the repository and shared with the
# services.
# The build budget, its warning, and its stop line are in pack.yaml (build_budget); make spend
# prints the running total by activity. Set the activity for a session of live work here. A command
# that starts a run through the api (make demo, the live checks) sends its own activity with the
# event, and the worker records that run's calls under it; a run that names none uses this value.
DATAPILOT_SPEND_ACTIVITY=development
# Build only: 1 turns on the course build's budget lines and its 10-dollar stop line (pack.yaml,
# build_budget). Leave it 0 on your own machine: every call is still recorded, and your own OpenAI
# project limit is your only limit, besides each assignment check's own spend cap.
DATAPILOT_BUILD_BUDGET=0
# Build only: the start of one unattended session, as a UTC time such as 2026-10-23T21:00:00Z.
# While it is set, the session limits (pack.yaml, build_budget.session) hold before every call too,
# counting only the spend since then. Leave it empty on your own machine.
DATAPILOT_SESSION_SINCE=

# --- Business date and display ---------------------------------------------------
# The day DataPilot treats as "today": the agent's prompt, "yesterday" for the digest (and for
# the anomaly job you add in Assignment 3), and fresh demo or assignment orders all use it. Run start times stay real time.
DATAPILOT_BUSINESS_DATE=2026-01-31
# Empty: the console shows times in each viewer's own time zone. Set an IANA zone to force one.
DATAPILOT_DISPLAY_TIMEZONE=

# --- Services -------------------------------------------------------------------
# Left unset, the api's address is localhost on API_PORT. Set it only for an api elsewhere.
# DATAPILOT_API_URL=http://localhost:8000
# Demo controls, for a class machine only. Only when 1 does POST /control/restart-worker work, and
# does the api take a demo's planted flags for that demo's own runs (the DataPilot-Planted header
# that make demo NAME=<demo> PLANTED=1 sends; each demo's own flags only). An assignment check's
# stack always runs with 0.
DATAPILOT_ALLOW_DEMO_CONTROLS=1

# --- Demo aids ------------------------------------------------------------------
# Pauses between lifecycle stages so runs visibly move across lanes. Never changes results.
DEMO_PACING=0
DEMO_PACING_SECONDS=2.0

# --- Planted bugs (all off by default; the console shows a chip for each one on) --
# The list and what each does: docs/planted-items.md (generated from platform/planted/registry.yaml).
BUG_UNBOUNDED_ROWS=0
BUG_NAMES_ONLY_SCHEMA=0
BUG_NAIVE_GUARD=0
BUG_NO_COST_GUARD=0
BUG_NO_RETRY_CAP=0
BUG_NO_IDEMPOTENCY=0
BUG_RANDOM_DIGEST_ID=0
BUG_MEMORY_CHECKPOINTER=0
BUG_KILLSWITCH_AT_CLAIM_ONLY=0
BUG_LOCK_DURING_LLM=0
BUG_SQL_TEXT_EVAL=0
BUG_NAIVE_ANALYZER=0
