# Names only. Real values go in .env, which is gitignored.

# REQUIRED. The only credential the repo cannot run without. Every live path — the
# agent loop, the verification loop, the worker, the sweep — needs it, and every
# failure that comes from it missing names this variable and this file.
ANTHROPIC_API_KEY=

# OPTIONAL. Leave it empty and everything still works.
#
# Without it: no trace links, no dataset upload, and tools/resumability_probe.py has
# nothing to measure. One warning naming this variable is logged, once, and the run
# continues. Nothing measured changes, because results/*.json is the system of record
# and LangSmith is never consulted for a number.
#
# This used to be a required setting, which contradicted that rule directly — a
# checkout with a valid ANTHROPIC_API_KEY and no LangSmith key refused to start. That
# is the declared-versus-enforced defect this repo is about, so it was fixed.
LANGSMITH_API_KEY=

# The LangSmith project every experiment is filed under. Unused without a key above.
LANGSMITH_PROJECT=loop-eng-workshop

# Tracing is off by default and must stay off for the offline test suite: the
# LangSmith SDK enables itself from the environment, and an exported tracing flag
# would make ordinary pytest runs attempt network sends. Phase 3 turns it on for
# the sweep. LANGCHAIN_TRACING_V2 is the older name for the same switch.
LANGSMITH_TRACING=false

# ---------------------------------------------------------------------------
# Everything below is OPTIONAL and has a working default. Listed because
# `.env.example` is the contract for what is configurable, and a variable that
# only appears in source is discoverable only by reading source.
# ---------------------------------------------------------------------------

# The warehouse generator's seed. CONFIGURATION, NOT A KNOB: changing it changes
# every gold answer, so a run under a different seed is not comparable with any
# committed measurement. Read by loopeng.settings (pydantic derives the variable
# name from the field).
# Default: 20260729
#WAREHOUSE_SEED=20260729

# Where the generated DuckDB warehouse lives. Rebuilt from the seed when absent.
# Default: warehouse.duckdb
#WAREHOUSE_PATH=warehouse.duckdb

# Where cell files, charts and artifacts are written.
# Default: results
#RESULTS_DIR=results

# Warehouse path for the hosted exhibit only. Read by deploy/hf/app.py, which
# needs a writable location on a Space.
# Default: /tmp/loopeng_warehouse.duckdb
#LOOPENG_WAREHOUSE=/tmp/loopeng_warehouse.duckdb

# ---------------------------------------------------------------------------
# The three below are INERT IN THIS BUILD. Setting them changes nothing.
#
# `src/loopeng/views/live_mode.py` implements a spend ceiling for a hosted
# instance that may call models, and it is tested — but no view, demo or entry
# point calls `read_config()`, and `LiveBudget` is never constructed. They are
# listed here because they ARE read by that module and would matter if it were
# wired, and because a spend gate that exists only in source is on the wrong
# side of the trade.
#
# DO NOT TREAT THESE AS A SPENDING CONTROL. If you host a view that can spend,
# set a limit in the Anthropic console — enforcement outside this codebase, and
# therefore actual enforcement. See SECURITY.md.
# ---------------------------------------------------------------------------

# Master switch. Must be 1, true, True or yes; anything else means off.
#LOOPENG_LIVE=

# Spend ceiling. Required when LOOPENG_LIVE is set — live with no ceiling is not
# a configuration that module accepts.
#LOOPENG_LIVE_CEILING_USD=

# Call-count ceiling alongside the spend ceiling.
#LOOPENG_LIVE_MAX_CALLS=
