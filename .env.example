# Names only. Real values go in .env, which is gitignored.

# REQUIRED. The only credential the repo cannot run without. Every live path — the
# agent loop, the verification loop, the worker, the sweep — needs it, and every
# failure that comes from it missing names this variable and this file.
ANTHROPIC_API_KEY=

# OPTIONAL. Leave it empty and everything still works.
#
# Without it: no trace links, no dataset upload, and tools/resumability_probe.py has
# nothing to measure. One warning naming this variable is logged, once, and the run
# continues. Nothing measured changes, because results/*.json is the system of record
# and LangSmith is never consulted for a number.
#
# This used to be a required setting, which contradicted that rule directly — a
# checkout with a valid ANTHROPIC_API_KEY and no LangSmith key refused to start. That
# is the declared-versus-enforced defect this repo is about, so it was fixed.
LANGSMITH_API_KEY=

# The LangSmith project every experiment is filed under. Unused without a key above.
LANGSMITH_PROJECT=loop-eng-workshop

# Tracing is off by default and must stay off for the offline test suite: the
# LangSmith SDK enables itself from the environment, and an exported tracing flag
# would make ordinary pytest runs attempt network sends. Phase 3 turns it on for
# the sweep. LANGCHAIN_TRACING_V2 is the older name for the same switch.
LANGSMITH_TRACING=false
